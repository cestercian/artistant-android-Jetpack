<?xml version="1.0" encoding="utf-8"?>
<!-- Themed-icon layer (API 33+). The launcher tints this from the user's
     wallpaper palette, so the fill colour is discarded and only the SHAPE
     matters — same outline as `ic_launcher_foreground`, drawn opaque.

     It is a separate file rather than a reuse of the foreground because the
     foreground's fill is the brand lime: handing that to the themed slot works
     today only because the tint overrides it, and would silently start shipping
     a lime themed icon the day that behaviour changed. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M54,32.16 L76.68,75.84 L65.76,75.84 L61.95,65.76 L46.05,65.76 L42.24,75.84 L31.32,75.84 Z M54,44.76 L58.77,57.36 L49.23,57.36 Z" />
</vector>
