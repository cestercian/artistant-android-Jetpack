<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Read-only connectivity check for the media UploadQueue: offline, every attempt fails
         instantly and each failure spends one of a task's three, so the drain stops instead of
         burning the artist's cover. Normal permission, no runtime prompt. WorkManager's
         NetworkType.CONNECTED constraint merges the same one in — declared here so the queue
         doesn't depend on a transitive manifest for a read it makes directly. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Push notifications (API 33+ runtime permission; requested at the notif step / before
         push registration). Pre-33 devices grant it at install. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- CalendarContract mirror of confirmed gigs (Profile → Sync gigs to calendar). -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- Wizard cover capture (CameraX / TakePicture). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".ArtistantApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:theme="@style/Theme.Artistant">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Artistant">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- OAuth callback (Google/Apple external-browser return). Must match the
                 supabase-kt Auth { scheme; host } config AND the Supabase dashboard's
                 Additional Redirect URLs: in.artistant.app://login-callback -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="in.artistant.app" android:host="login-callback" />
            </intent-filter>
        </activity>

        <!-- FCM: token rotation + foreground data messages. Soft-fails without google-services.json. -->
        <service
            android:name=".platform.push.ArtistantMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Cover / sample capture shares via FileProvider (camera TakePicture). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Custom WorkManager Configuration.Provider — remove default initializer. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
